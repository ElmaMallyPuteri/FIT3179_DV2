{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Purpose of caravan and camping trips",
    "subtitle": "Each square is 1 in every 100 trips, year to March 2026"
  },
  "width": 260,
  "height": 260,
  "autosize": {
    "type": "pad"
  },
  "config": {
    "font": "Arial, Helvetica, sans-serif",
    "background": "#FFFDF8",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial, Helvetica, sans-serif",
      "titleFont": "Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F",
      "domainColor": "#617891",
      "tickColor": "#617891",
      "gridColor": "#E6DCCB"
    },
    "legend": {
      "labelFont": "Arial, Helvetica, sans-serif",
      "titleFont": "Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F"
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 17,
      "fontWeight": "bold",
      "anchor": "start",
      "color": "#25344F",
      "subtitleFont": "Arial, Helvetica, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#617891",
      "subtitlePadding": 4,
      "offset": 10
    }
  },
  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "as": "i"
    }
  },
  "transform": [
    {
      "calculate": "datum.i % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.i / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.i < 80 ? 'Holiday (80)' : datum.i < 92 ? 'Visiting friends and relatives (12)' : 'Other reasons (8)'",
      "as": "purpose"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 520
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "purpose",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Holiday (80)",
              "Visiting friends and relatives (12)",
              "Other reasons (8)"
            ],
            "range": [
              "#25344F",
              "#6F4D38",
              "#D5B893"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 1,
            "symbolType": "square",
            "labelLimit": 300
          }
        },
        "tooltip": [
          {
            "field": "purpose",
            "title": "Purpose (out of 100 trips)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "80 of every 100"
          }
        ]
      },
      "mark": {
        "type": "text",
        "color": "#FFFFFF",
        "fontWeight": "bold",
        "fontSize": 15,
        "align": "center",
        "baseline": "middle",
        "font": "Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "value": 130
        },
        "y": {
          "value": 96
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "trips are holidays"
          }
        ]
      },
      "mark": {
        "type": "text",
        "color": "#FFFFFF",
        "fontWeight": "bold",
        "fontSize": 15,
        "align": "center",
        "baseline": "middle",
        "font": "Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "value": 130
        },
        "y": {
          "value": 118
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}
