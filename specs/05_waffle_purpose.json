{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Purpose of caravan and camping trips",
    "subtitle": "Each square is 1 in every 100 trips, year to March 2026"
  },
  "width": 400,
  "height": 260,
  "autosize": {
    "type": "pad"
  },
  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "as": "i"
    }
  },
  "transform": [
    {
      "calculate": "datum.i % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.i / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.i < 80 ? 'Holiday (80)' : datum.i < 92 ? 'Visiting friends and relatives (12)' : 'Other reasons (8)'",
      "as": "purpose"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 520
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "range": [
              0,
              260
            ]
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "purpose",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Holiday (80)",
              "Visiting friends and relatives (12)",
              "Other reasons (8)"
            ],
            "range": [
              "#25344F",
              "#6F4D38",
              "#D5B893"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 1,
            "symbolType": "square",
            "labelLimit": 380
          }
        },
        "tooltip": [
          {
            "field": "purpose",
            "title": "Purpose (out of 100 trips)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "80"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 54,
        "fontWeight": "bold",
        "color": "#25344F",
        "font": "Fraunces, Georgia, serif"
      },
      "encoding": {
        "x": {
          "value": 282
        },
        "y": {
          "value": 46
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "of every 100 trips",
            "y": 92
          },
          {
            "t": "are holidays",
            "y": 110
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 14,
        "color": "#25344F",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "value": 284
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}
