{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Trips by quarter versus each state’s average",
    "subtitle": "All overnight trips, July 2025 to June 2026"
  },
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/state_quarter.csv",
    "format": {
      "type": "csv",
      "parse": {
        "trips_k": "number",
        "nights_k": "number",
        "spend_m": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "trips_k",
          "as": "avg_k"
        },
        {
          "op": "sum",
          "field": "trips_k",
          "as": "total_k"
        }
      ],
      "groupby": [
        "abbr"
      ]
    },
    {
      "calculate": "(datum.trips_k / datum.avg_k - 1) * 100",
      "as": "pct"
    },
    {
      "calculate": "{'Sep 2025':'Jul–Sep 2025','Dec 2025':'Oct–Dec 2025','Mar 2026':'Jan–Mar 2026','Jun 2026':'Apr–Jun 2026'}[datum.quarter]",
      "as": "ql"
    },
    {
      "calculate": "(datum.pct >= 0 ? '+' : '−') + round(abs(datum.pct)) + '%'",
      "as": "pct_text"
    },
    {
      "calculate": "datum.abbr == 'NT' && datum.quarter == 'Sep 2025' ? 'dry-season peak' : datum.abbr == 'NT' && datum.quarter == 'Mar 2026' ? 'wet-season low' : datum.abbr == 'TAS' && datum.quarter == 'Mar 2026' ? 'summer peak' : ''",
      "as": "cell_note"
    }
  ],
  "encoding": {
    "x": {
      "field": "ql",
      "type": "ordinal",
      "sort": [
        "Jul–Sep 2025",
        "Oct–Dec 2025",
        "Jan–Mar 2026",
        "Apr–Jun 2026"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "orient": "bottom",
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "abbr",
      "type": "nominal",
      "sort": {
        "field": "total_k",
        "op": "max",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "ticks": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFDF8",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              -35,
              0,
              35
            ],
            "range": [
              "#632024",
              "#F3EBDD",
              "#25344F"
            ],
            "clamp": true
          },
          "title": "Trips compared with the state’s own average (%)",
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 240,
            "titleLimit": 400,
            "format": "+d",
            "values": [
              -30,
              -15,
              0,
              15,
              30
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "ql",
            "title": "Quarter"
          },
          {
            "field": "trips_k",
            "title": "Trips (000s)",
            "format": ",.0f"
          },
          {
            "field": "pct_text",
            "title": "Compared with own average"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.cell_note == ''"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "text": {
          "field": "pct_text",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "abs(datum.pct) >= 15",
            "value": "#FFFFFF"
          },
          "value": "#25344F"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.cell_note != ''"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "dy": -7,
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "text": {
          "field": "pct_text",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "abs(datum.pct) >= 15",
            "value": "#FFFFFF"
          },
          "value": "#25344F"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.cell_note != ''"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "dy": 8,
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "text": {
          "field": "cell_note",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "abs(datum.pct) >= 15",
            "value": "#FFFFFF"
          },
          "value": "#25344F"
        }
      }
    }
  ]
}
