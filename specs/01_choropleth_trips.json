{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Overnight trips by state: year ending June 2026",
  "width": "container",
  "height": 460,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "font": "Barlow",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "domainColor": "#9aa5a8",
      "tickColor": "#9aa5a8",
      "gridColor": "#e3e8e6"
    },
    "legend": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelFontSize": 12
    },
    "title": {
      "font": "Barlow Condensed",
      "fontSize": 17,
      "anchor": "start",
      "color": "#1c262b"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "data": {
    "url": "data/australia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "STE_2021_AUST_GDA94"
    }
  },
  "transform": [
    {
      "filter": "indexof(['Z','9'], datum.properties.STE_CODE21) < 0"
    },
    {
      "lookup": "properties.STE_NAME21",
      "from": {
        "data": {
          "url": "data/state_totals.csv"
        },
        "key": "state",
        "fields": [
          "trips_k",
          "nights_k",
          "spend_m",
          "avg_nights"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "trips_k",
      "type": "quantitative",
      "scale": {
        "scheme": "teals"
      },
      "title": "Trips (thousands)",
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 220,
        "titleLimit": 300
      }
    },
    "tooltip": [
      {
        "field": "properties.STE_NAME21",
        "title": "State"
      },
      {
        "field": "trips_k",
        "title": "Trips (000s)",
        "format": ","
      },
      {
        "field": "nights_k",
        "title": "Nights (000s)",
        "format": ","
      },
      {
        "field": "spend_m",
        "title": "Spend ($m)",
        "format": ","
      }
    ]
  }
}