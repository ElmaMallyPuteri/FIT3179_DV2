{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Four classic road trips (simplified routes)",
  "width": "container",
  "height": 460,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "font": "Barlow",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "domainColor": "#9aa5a8",
      "tickColor": "#9aa5a8",
      "gridColor": "#e3e8e6"
    },
    "legend": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelFontSize": 12
    },
    "title": {
      "font": "Barlow Condensed",
      "fontSize": 17,
      "anchor": "start",
      "color": "#1c262b"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA94"
        }
      },
      "transform": [
        {
          "filter": "indexof(['Z','9'], datum.properties.STE_CODE21) < 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e3e8e6",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/routes.csv",
        "format": {
          "type": "csv",
          "parse": {
            "seq": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "route"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "strokeCap": "round",
        "interpolate": "linear"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "order": {
          "field": "seq",
          "type": "quantitative"
        },
        "color": {
          "field": "route",
          "type": "nominal",
          "title": "Click a route to highlight it",
          "legend": {
            "orient": "bottom",
            "columns": 2,
            "labelLimit": 300,
            "titleLimit": 400
          },
          "scale": {
            "domain": [
              "Great Ocean Road",
              "Nullarbor (Eyre Hwy)",
              "Stuart Highway",
              "The Big Lap (simplified)"
            ],
            "range": [
              "#d1601f",
              "#1f6f6a",
              "#6b4fa3",
              "#222b30"
            ]
          }
        },
        "strokeDash": {
          "field": "route",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Great Ocean Road",
              "Nullarbor (Eyre Hwy)",
              "Stuart Highway",
              "The Big Lap (simplified)"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                1,
                0
              ],
              [
                1,
                0
              ],
              [
                9,
                6
              ]
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 1
          },
          "value": 0.18
        },
        "tooltip": [
          {
            "field": "route"
          }
        ]
      }
    }
  ]
}