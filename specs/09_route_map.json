{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Four classic caravan routes",
    "subtitle": "Simplified routes drawn from town locations"
  },
  "width": "container",
  "height": 460,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "font": "Arial, Helvetica, sans-serif",
    "background": "#FFFDF8",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial, Helvetica, sans-serif",
      "titleFont": "Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F",
      "domainColor": "#617891",
      "tickColor": "#617891",
      "gridColor": "#E6DCCB"
    },
    "legend": {
      "labelFont": "Arial, Helvetica, sans-serif",
      "titleFont": "Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F"
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 17,
      "fontWeight": "bold",
      "anchor": "start",
      "color": "#25344F",
      "subtitleFont": "Arial, Helvetica, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#617891",
      "subtitlePadding": 4,
      "offset": 10
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA94"
        }
      },
      "transform": [
        {
          "filter": "indexof(['Z','9'], datum.properties.STE_CODE21) < 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#EDE4D3",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/routes.csv",
        "format": {
          "type": "csv",
          "parse": {
            "seq": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "route"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "strokeCap": "round",
        "interpolate": "linear"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "order": {
          "field": "seq",
          "type": "quantitative"
        },
        "color": {
          "field": "route",
          "type": "nominal",
          "title": "Click a route to highlight it",
          "scale": {
            "domain": [
              "Great Ocean Road",
              "Nullarbor (Eyre Hwy)",
              "Stuart Highway",
              "The Big Lap (simplified)"
            ],
            "range": [
              "#632024",
              "#6F4D38",
              "#25344F",
              "#617891"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 2,
            "labelLimit": 300,
            "titleLimit": 400,
            "symbolType": "stroke",
            "symbolStrokeWidth": 4
          }
        },
        "strokeDash": {
          "field": "route",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Great Ocean Road",
              "Nullarbor (Eyre Hwy)",
              "Stuart Highway",
              "The Big Lap (simplified)"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                1,
                0
              ],
              [
                1,
                0
              ],
              [
                8,
                6
              ]
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "route",
            "title": "Route"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 143.2,
            "lat": -40.0,
            "t": "Great Ocean Road"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "fontStyle": "normal",
        "color": "#632024",
        "font": "Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
