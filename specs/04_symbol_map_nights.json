{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Nights spent away, by state",
    "subtitle": "All overnight trips, year to June 2026"
  },
  "width": "container",
  "height": 470,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA94"
        }
      },
      "transform": [
        {
          "filter": "indexof(['Z','9'], datum.properties.STE_CODE21) < 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#EDE4D3",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/state_metrics.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "tile_x": "number",
            "tile_y": "number",
            "trips_k": "number",
            "nights_k": "number",
            "spend_m": "number",
            "avg_nights": "number",
            "pop_k": "number",
            "trips_per_1000": "number",
            "spend_per_trip": "number",
            "spend_per_night": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.nights_k / 1000",
          "as": "nights_m"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "nights_m",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              120
            ],
            "range": [
              0,
              5200
            ]
          },
          "title": "Nights away (millions)",
          "legend": null
        },
        "color": {
          "condition": {
            "test": "datum.abbr == 'QLD'",
            "value": "#632024"
          },
          "value": "#617891"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "nights_m",
            "title": "Nights (millions)",
            "format": ".1f"
          },
          {
            "field": "trips_k",
            "title": "Trips (000s)",
            "format": ",.0f"
          },
          {
            "field": "avg_nights",
            "title": "Nights per trip"
          }
        ],
        "stroke": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#25344F"
          },
          "value": "#FFFFFF"
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 3
          },
          "value": 1.5
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "abbr"
            ]
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/state_metrics.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "tile_x": "number",
            "tile_y": "number",
            "trips_k": "number",
            "nights_k": "number",
            "spend_m": "number",
            "avg_nights": "number",
            "pop_k": "number",
            "trips_per_1000": "number",
            "spend_per_trip": "number",
            "spend_per_night": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof(['NSW','VIC','QLD','WA','SA'], datum.abbr) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#FFFFFF",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/state_metrics.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "tile_x": "number",
            "tile_y": "number",
            "trips_k": "number",
            "nights_k": "number",
            "spend_m": "number",
            "avg_nights": "number",
            "pop_k": "number",
            "trips_per_1000": "number",
            "spend_per_trip": "number",
            "spend_per_night": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "!(indexof(['NSW','VIC','QLD','WA','SA'], datum.abbr) >= 0)"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#25344F",
        "align": "left",
        "dx": 13,
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Queensland: most nights",
            "y": 12
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#632024",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "value": 6
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "(92.0m), though Victoria",
            "y": 29
          },
          {
            "t": "has more trips (31.0m)",
            "y": 45
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "normal",
        "color": "#25344F",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "value": 6
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Nights away (millions)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#25344F",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "value": 6
        },
        "y": {
          "value": 376
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "v": 10,
            "x": 24
          },
          {
            "v": 50,
            "x": 78
          },
          {
            "v": 100,
            "x": 152
          }
        ]
      },
      "transform": [
        {
          "calculate": "5200*datum.v/120",
          "as": "area"
        },
        {
          "calculate": "sqrt(datum.area/PI)",
          "as": "r"
        },
        {
          "calculate": "464-datum.r",
          "as": "y"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#617891",
        "fillOpacity": 0.25,
        "stroke": "#617891",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "size": {
          "field": "area",
          "type": "quantitative",
          "scale": null,
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "v": "10",
            "x": 24,
            "y": 452
          },
          {
            "v": "50",
            "x": 78,
            "y": 438
          },
          {
            "v": "100",
            "x": 152,
            "y": 427
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#25344F",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "v",
          "type": "nominal"
        }
      }
    }
  ]
}
