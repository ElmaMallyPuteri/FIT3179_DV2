{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Ranking of states by visitor spending",
    "subtitle": "All overnight trips, July 2025 to June 2026"
  },
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "font": "\"Public Sans\", Arial, Helvetica, sans-serif",
    "background": "#FFFDF8",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "titleFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F",
      "domainColor": "#617891",
      "tickColor": "#617891",
      "gridColor": "#E6DCCB"
    },
    "legend": {
      "labelFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "titleFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F"
    },
    "title": {
      "font": "Times New Roman, Times, serif",
      "fontSize": 17,
      "fontWeight": "bold",
      "anchor": "start",
      "color": "#25344F",
      "subtitleFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#617891",
      "subtitlePadding": 4,
      "offset": 10
    }
  },
  "data": {
    "url": "data/state_quarter.csv",
    "format": {
      "type": "csv",
      "parse": {
        "trips_k": "number",
        "nights_k": "number",
        "spend_m": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "groupby": [
        "quarter"
      ],
      "sort": [
        {
          "field": "spend_m",
          "order": "descending"
        }
      ]
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "!(indexof(['NSW','VIC','QLD'], datum.abbr) >= 0)"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 0.9,
        "point": {
          "filled": true,
          "size": 40
        }
      },
      "encoding": {
        "x": {
          "field": "quarter",
          "type": "ordinal",
          "sort": [
            "Sep 2025",
            "Dec 2025",
            "Mar 2026",
            "Jun 2026"
          ],
          "title": null,
          "scale": {
            "padding": 0.5
          },
          "axis": {
            "labelAngle": 0,
            "labelExpr": "{'Sep 2025':'Jul–Sep','Dec 2025':'Oct–Dec','Mar 2026':'Jan–Mar','Jun 2026':'Apr–Jun'}[datum.value]"
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              8.5,
              -0.4
            ]
          },
          "title": "Rank (1 = most spending)",
          "axis": {
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "grid": false,
            "format": "d"
          }
        },
        "color": {
          "field": "abbr",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "NSW",
              "VIC",
              "QLD",
              "SA",
              "WA",
              "TAS",
              "NT",
              "ACT"
            ],
            "range": [
              "#25344F",
              "#6F4D38",
              "#632024",
              "#8F7F66",
              "#8F7F66",
              "#8F7F66",
              "#8F7F66",
              "#8F7F66"
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "quarter",
            "title": "Quarter (ending)"
          },
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "spend_m",
            "title": "Spending ($m)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "indexof(['NSW','VIC','QLD'], datum.abbr) >= 0"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 4.5,
        "point": {
          "filled": true,
          "size": 110
        }
      },
      "encoding": {
        "x": {
          "field": "quarter",
          "type": "ordinal",
          "sort": [
            "Sep 2025",
            "Dec 2025",
