            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "quarter": "Dec 2025",
            "rank": 1,
            "t": "NSW overtakes QLD"
          }
        ]
      },
      "mark": {
        "type": "text",
