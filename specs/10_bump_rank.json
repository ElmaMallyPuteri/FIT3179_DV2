            ]
          },
          "title": "Rank (1 = most spending)",
          "axis": {
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "grid": false,
            "format": "d"
          }
        },
        "color": {
          "field": "abbr",
          "type": "nominal",
