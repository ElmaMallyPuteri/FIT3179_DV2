{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Caravan and camping trips, millions",
    "subtitle": "Caravan and camping trips only. Periods overlap, so compare with care."
  },
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "font": "\"Public Sans\", Arial, Helvetica, sans-serif",
    "background": "#FFFDF8",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "titleFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F",
      "domainColor": "#617891",
      "tickColor": "#617891",
      "gridColor": "#E6DCCB"
    },
    "legend": {
      "labelFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "titleFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F"
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 17,
      "fontWeight": "bold",
      "anchor": "start",
      "color": "#25344F",
      "subtitleFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#617891",
      "subtitlePadding": 4,
      "offset": 10
    }
  },
  "data": {
    "values": [
      {
        "p": "2024 (adjusted)",
        "m": 15.2
      },
      {
        "p": "2025",
        "m": 17.3
      },
      {
        "p": "Year to Mar 2026",
        "m": 17.7
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": {
          "band": 0.55
        }
      },
      "encoding": {
        "x": {
          "field": "p",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              22
            ]
          },
          "title": "Trips (millions)",
          "axis": {
            "values": [
              0,
              5,
              10,
              15,
              20
            ]
          }
        },
        "color": {
          "condition": {
            "test": "datum.m == 15.2",
            "value": "#D5B893"
          },
          "value": "#6F4D38"
        },
        "tooltip": [
          {
            "field": "p",
            "title": "Period"
          },
          {
            "field": "m",
            "title": "Trips (millions)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#25344F",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "field": "p",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              22
            ]
          },
          "title": "Trips (millions)",
          "axis": {
            "values": [
              0,
              5,
              10,
              15,
              20
            ]
          }
        },
        "text": {
          "field": "m",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "p": "2025",
            "m": 17.3,
            "t": "+14% on 2024"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": -30,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#632024",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "field": "p",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              22
            ]
          },
          "title": "Trips (millions)",
          "axis": {
            "values": [
              0,
              5,
              10,
              15,
              20
            ]
          }
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}