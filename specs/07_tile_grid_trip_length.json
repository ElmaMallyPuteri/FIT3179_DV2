{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average nights per trip",
    "subtitle": "All overnight trips, year to June 2026"
  },
  "width": 360,
  "height": 360,
  "autosize": {
    "type": "pad"
  },
  "data": {
    "url": "data/state_metrics.csv",
    "format": {
      "type": "csv",
      "parse": {
        "lon": "number",
        "lat": "number",
        "tile_x": "number",
        "tile_y": "number",
        "trips_k": "number",
        "nights_k": "number",
        "spend_m": "number",
        "avg_nights": "number",
        "pop_k": "number",
        "trips_per_1000": "number",
        "spend_per_trip": "number",
        "spend_per_night": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 6400
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.5,
              3.5
            ]
          },
          "axis": null
        },
        "y": {
          "field": "tile_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.5,
              3.5
            ],
            "reverse": true
          },
          "axis": null
        },
        "color": {
          "field": "avg_nights",
          "type": "quantitative",
          "scale": {
            "domain": [
              2.7,
              3.267,
              3.833,
              4.4
            ],
            "range": [
              "#F3EBDD",
              "#D5B893",
              "#617891",
              "#25344F"
            ],
            "interpolate": "lab"
          },
          "title": "Nights per trip",
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "titleLimit": 300,
            "values": [
              3,
              3.5,
              4
            ],
            "format": ".1f"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "avg_nights",
            "title": "Nights per trip"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 16,
        "fontWeight": "bold",
        "dy": -10,
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.5,
              3.5
            ]
          },
          "axis": null
        },
        "y": {
          "field": "tile_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.5,
              3.5
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "abbr",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.avg_nights > 3.9",
            "value": "#FFFFFF"
          },
          "value": "#25344F"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 15,
        "dy": 11,
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.5,
              3.5
            ]
          },
          "axis": null
        },
        "y": {
          "field": "tile_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.5,
              3.5
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "avg_nights",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.avg_nights > 3.9",
            "value": "#FFFFFF"
          },
          "value": "#25344F"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Longest trips:"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#632024",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "x": {
          "value": 4
        },
        "y": {
          "value": 36
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
