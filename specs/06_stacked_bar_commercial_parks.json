      "encoding": {
        "y": {
          "field": "measure",
          "type": "ordinal",
          "sort": [
            "Trips",
            "Nights away",
            "Spending"
          ],
          "title": null,
          "scale": {
            "paddingInner": 0.5,
            "paddingOuter": 0.25
