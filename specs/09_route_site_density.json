      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -7,
        "fontSize": 11,
        "color": "#25344F",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
