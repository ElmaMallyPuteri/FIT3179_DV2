    {
      "data": {
        "url": "data/route_summary.csv",
        "format": {
          "type": "csv",
          "parse": {
            "km": "number",
            "sites": "number",
            "sites_per_100km": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.route == 'Great Ocean Road'"
        },
        {
          "calculate": "{'Great Ocean Road':'Great Ocean Road','Nullarbor (Eyre Highway)':'Nullarbor (Eyre Hwy)','Stuart Highway':'Stuart Highway','Rest of the Big Lap':'Rest of the Big Lap'}[datum.route]",
          "as": "short"
        },
        {
          "calculate": "datum.short",
          "as": "t"
        },
        {
          "calculate": "143.4",
          "as": "lx"
        },
        {
          "calculate": "-40.1",
          "as": "ly"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dy": -7,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#25344F",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/route_summary.csv",
