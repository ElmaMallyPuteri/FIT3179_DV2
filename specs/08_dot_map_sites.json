{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Caravan parks and campsites",
    "subtitle": "9,782 sites mapped in OpenStreetMap"
  },
  "width": "container",
  "height": 440,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "font": "\"Public Sans\", Arial, Helvetica, sans-serif",
    "background": "#FFFDF8",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "titleFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F",
      "domainColor": "#617891",
      "tickColor": "#617891",
      "gridColor": "#E6DCCB"
    },
    "legend": {
      "labelFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "titleFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#25344F",
      "titleColor": "#25344F"
    },
    "title": {
      "font": "Fraunces, Georgia, \"Times New Roman\", serif",
      "fontSize": 17,
      "fontWeight": "bold",
      "anchor": "start",
      "color": "#25344F",
      "subtitleFont": "\"Public Sans\", Arial, Helvetica, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#617891",
      "subtitlePadding": 4,
      "offset": 10
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA94"
        }
      },
      "transform": [
        {
          "filter": "indexof(['Z','9'], datum.properties.STE_CODE21) < 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#EDE4D3",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/caravan_sites.csv"
      },
      "transform": [
        {
          "calculate": "datum.name == '' || datum.name == null ? 'Unnamed site' : datum.name",
          "as": "label"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 11,
        "opacity": 0.6,
        "strokeWidth": 0
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "order": {
          "field": "type",
          "type": "nominal",
          "sort": "ascending"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "caravan_site",
              "camp_site"
            ],
            "range": [
              "#632024",
              "#617891"
            ]
          },
          "legend": {
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 90,
            "labelExpr": "datum.value == 'caravan_site' ? 'Caravan park (2,015)' : 'Campsite (7,767)'"
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Name"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 125.0,
            "lat": -25.0,
            "t": "Outback: sites are"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "fontStyle": "normal",
        "color": "#25344F",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 125.0,
            "lat": -26.9,
            "t": "hundreds of km apart"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "fontStyle": "normal",
        "color": "#25344F",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 113.6,
            "lat": -39.2,
            "t": "Most sites hug the east and"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "fontStyle": "normal",
        "color": "#632024",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 113.6,
            "lat": -41.1,
            "t": "south-east coasts  →"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "fontStyle": "normal",
        "color": "#632024",
        "font": "\"Public Sans\", Arial, Helvetica, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}
