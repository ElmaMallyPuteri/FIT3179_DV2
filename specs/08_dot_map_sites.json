{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Caravan parks and campsites",
    "subtitle": [
      "9,782 sites mapped in OpenStreetMap.",
      "Dense along the east and south-east coasts;",
      "in the outback, sites are hundreds of km apart."
    ]
  },
  "width": "container",
  "height": 440,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA94"
        }
      },
      "transform": [
        {
          "filter": "indexof(['Z','9'], datum.properties.STE_CODE21) < 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#EDE4D3",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/caravan_sites.csv"
      },
      "transform": [
        {
          "calculate": "datum.name == '' || datum.name == null ? 'Unnamed site' : datum.name",
          "as": "label"
        },
        {
          "filter": "show == 'All sites' || (show == 'Caravan parks' && datum.type == 'caravan_site') || (show == 'Campsites' && datum.type == 'camp_site')"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 11,
        "opacity": 0.6,
        "strokeWidth": 0
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "order": {
          "field": "type",
          "type": "nominal",
          "sort": "ascending"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "caravan_site",
              "camp_site"
            ],
            "range": [
              "#632024",
              "#617891"
            ]
          },
          "legend": {
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 90,
            "labelExpr": "datum.value == 'caravan_site' ? 'Caravan park (2,015)' : 'Campsite (7,767)'",
            "labelLimit": 260
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Name"
          }
        ]
      }
    }
  ],
  "params": [
    {
      "name": "show",
      "value": "All sites",
      "bind": {
        "input": "radio",
        "options": [
          "All sites",
          "Caravan parks",
          "Campsites"
        ],
        "name": "Show: "
      }
    }
  ]
}
