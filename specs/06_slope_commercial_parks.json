{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Commercial parks win a bigger share of nights and dollars than trips",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "font": "Barlow",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "domainColor": "#9aa5a8",
      "tickColor": "#9aa5a8",
      "gridColor": "#e3e8e6"
    },
    "legend": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelFontSize": 12
    },
    "title": {
      "font": "Barlow Condensed",
      "fontSize": 17,
      "anchor": "start",
      "color": "#1c262b"
    }
  },
  "data": {
    "values": [
      {
        "m": "Share of trips",
        "v": 67
      },
      {
        "m": "Share of nights",
        "v": 70
      },
      {
        "m": "Share of spending",
        "v": 75
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 110,
          "color": "#1f6f6a"
        },
        "color": "#1f6f6a",
        "strokeWidth": 3
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#1c262b"
      },
      "encoding": {
        "text": {
          "field": "v",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "m": "Share of nights",
            "v": 58,
            "t": "Parks hold two thirds of trips"
          },
          {
            "m": "Share of nights",
            "v": 53,
            "t": "but three quarters of spending."
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#5b6a70"
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "m",
      "type": "ordinal",
      "sort": null,
      "title": null,
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "v",
      "type": "quantitative",
      "scale": {
        "domain": [
          40,
          85
        ]
      },
      "title": "Commercial parks' share (%)"
    }
  }
}